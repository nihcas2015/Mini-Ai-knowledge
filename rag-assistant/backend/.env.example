# =============================================================================
# Mini AI Knowledge Assistant — Environment Variables
# Copy this to .env and fill in your actual keys.
# =============================================================================

# --- Groq API keys (3x for rotation) ---
GROQ_API_KEY_1=your_groq_key_1
GROQ_API_KEY_2=your_groq_key_2
GROQ_API_KEY_3=your_groq_key_3

# --- OpenRouter API keys (3x for rotation) ---
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=your_openrouter_key_2
OPENROUTER_API_KEY_3=your_openrouter_key_3

# --- Gemini API keys (3x for rotation) ---
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3

# --- Cohere (reranking) ---
COHERE_API_KEY=your_cohere_key

# --- Telegram (admin notifications) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]

