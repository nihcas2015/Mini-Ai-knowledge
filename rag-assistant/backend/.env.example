# =============================================================================
# Mini AI Knowledge Assistant — Environment Variables
# Copy this to .env and fill in your actual keys.
# =============================================================================

# --- Groq API keys (3x for rotation) ---
GROQ_API_KEY_1=your_groq_key_1
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- OpenRouter API keys (3x for rotation) ---
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# --- Gemini API keys (3x for rotation) ---
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Qdrant Cloud ---
QDRANT_CLOUD_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_CLOUD_API_KEY=your_qdrant_cloud_api_key

# --- Telegram (admin notifications, optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CORS (add your Vercel domain) ---
ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

